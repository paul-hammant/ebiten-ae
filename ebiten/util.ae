hex_val(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0 - 1
}

// Build the debug font image (a core image handle). Call once, reuse.
debug_font_new() -> ptr {
    n = string.length(FONT_PNG_HEX)
    b = bytes.new(n / 2)
    p = bytes.data(b)
    bi = 0
    i = 0
    hi = 0 - 1
    while i < n {
        c = string_char_at(FONT_PNG_HEX, i)
        if c < 0 { c = c + 256 }
        v = hex_val(c)
        if v >= 0 {
            if hi < 0 {
                hi = v
            } else {
                mem.set_byte(p, bi, hi * 16 + v)
                bi = bi + 1
                hi = 0 - 1
            }
        }
        i = i + 1
    }
    img = png.png_decode(p, bi)
    bytes.free(b)
    return img
}

// DebugPrintAt: draw str onto dst with the 6x16 font, top-left at (ox, oy).
// Newlines wrap. `font` is from debug_font_new().
debug_print_at(font: ptr, dst: ptr, str: string, ox: int, oy: int) {
    if font == null { return }
    o = core.opts_new()
    g = core.opts_geom(o)
    n = string.length(str)
    x = 0
    y = 0
    i = 0
    while i < n {
        c = string_char_at(str, i)
        if c < 0 { c = c + 256 }
        if c == 10 {
            x = 0
            y = y + 16
        } else {
            sx = (c % 32) * 6
            sy = (c / 32) * 16
            glyph = core.image_sub(font, sx, sy, sx + 6, sy + 16)
            core.geom_reset(g)
            core.geom_translate(g, (x + ox + 1) * 1.0, (y + oy) * 1.0)
            core.draw_image(dst, glyph, o)
            core.image_free(glyph)
            x = x + 6
        }
        i = i + 1
    }
    core.opts_free(o)
}

const ALIGN_LEFT: int = 0
const ALIGN_CENTER: int = 1
const ALIGN_RIGHT: int = 2

// Length of the line starting at `from` (up to \n or end).
line_len(str: string, from: int, n: int) -> int {
    i = from
    while i < n {
        c = string_char_at(str, i)
        if c == 10 { return i - from }
        i = i + 1
    }
    return n - from
}

// Scaled multi-line text from the debug font. (ox, oy) anchors the first
// line; align positions each line about ox (left edge / center / right
// edge). Line height is 16*scale, advance 6*scale.
debug_print_scaled(font: ptr, dst: ptr, str: string, ox: float, oy: float,
                   scale: float, align: int) {
    if font == null { return }
    o = core.opts_new()
    g = core.opts_geom(o)
    n = string.length(str)
    y = 0.0
    i = 0
    while i < n {
        ll = line_len(str, i, n)
        lw = ll * 6.0 * scale
        x = ox
        if align == ALIGN_CENTER { x = ox - lw / 2.0 }
        if align == ALIGN_RIGHT { x = ox - lw }
        j = 0
        while j < ll {
            c = string_char_at(str, i + j)
            if c < 0 { c = c + 256 }
            sx = (c % 32) * 6
            sy = (c / 32) * 16
            glyph = core.image_sub(font, sx, sy, sx + 6, sy + 16)
            core.geom_reset(g)
            core.geom_scale(g, scale, scale)
            core.geom_translate(g, x + j * 6.0 * scale, oy + y)
            core.draw_image(dst, glyph, o)
            core.image_free(glyph)
            j = j + 1
        }
        i = i + ll
        if i < n { i = i + 1 }
        y = y + 16.0 * scale
    }
    core.opts_free(o)
}
