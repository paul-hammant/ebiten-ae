// ae/ebiten/util.ae — ebitenutil equivalents: the DebugPrint bitmap-font
// HUD. The 6x16-cell 256-glyph font sheet is the original ebitenutil/text.png
// (tests/testdata/text.png here; ebitenutil/ lives on legacy_golang), embedded
// below as hex (decoded once via ebiten.png on first use).

exports (
    debug_font_new, debug_print_at, debug_print_scaled,
    ALIGN_LEFT, ALIGN_CENTER, ALIGN_RIGHT
)

import ebiten.core
import ebiten.png
import std.mem
import std.bytes
import std.string

