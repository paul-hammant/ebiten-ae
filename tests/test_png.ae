// test_png.ae — decode ebitenutil/text.png (the DebugPrint font sheet) and
// check dims + ground-truth pixels (reference values from PIL).
//   ae run tests/test_png.ae

import ebiten.core
import ebiten.png

extern println(s: string)
extern exit(code: int)

assert_i(name: string, got: int, want: int) {
    if got != want {
        println("FAIL ${name}: got ${got} want ${want}")
        exit(1)
    }
}

main() {
    img = png.png_load("tests/testdata/text.png")
    if img == null {
        println("FAIL: decode returned null")
        exit(1)
    }
    assert_i("w", core.image_w(img), 192)
    assert_i("h", core.image_h(img), 128)
    // PIL: first opaque pixel at (0,3) = white opaque; (1,17) transparent.
    assert_i("px(0,3) r", core.image_at_r(img, 0, 3), 255)
    assert_i("px(0,3) a", core.image_at_a(img, 0, 3), 255)
    assert_i("px(0,0) a", core.image_at_a(img, 0, 0), 0)
    assert_i("px(1,17) a", core.image_at_a(img, 1, 17), 0)
    println("test_png OK")
}
