// test_audio.ae — audio mapping over std.audio (headless: transport +
// volume + duration on a real Ebiten example asset).
import aebiten.audio

extern println(s: string)
extern exit(code: int)

main() {
    if audio.context_new(48000) != 1 {
        println("test_audio SKIP (no audio engine)")
        return
    }
    p = audio.player_from_wav("examples/resources/audio/jab.wav")
    if p == null {
        println("FAIL: load jab.wav")
        exit(1)
    }
    d = audio.player_duration_ms(p)
    if d <= 0 {
        println("FAIL: duration ${d}")
        exit(1)
    }
    audio.player_set_volume(p, 0.5)
    v = audio.player_volume(p)
    if v < 0.45 || v > 0.55 {
        println("FAIL: volume ${v}")
        exit(1)
    }
    audio.player_play(p)
    audio.player_pause(p)
    audio.player_seek_ms(p, d / 2)
    pos = audio.player_position_ms(p)
    if pos <= 0 {
        println("FAIL: position ${pos}")
        exit(1)
    }
    audio.player_free(p)
    audio.context_close()
    println("test_audio OK (duration=${d}ms null_backend=${audio.is_null_backend()})")
}
