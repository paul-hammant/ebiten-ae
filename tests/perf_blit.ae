import ebiten.core
import std.os
extern println(s: string)

main() {
    screen = core.image_new(640, 480)
    tile = core.image_new(32, 32)
    core.image_fill(tile, 100, 150, 200, 255)
    o = core.opts_new()
    g = core.opts_geom(o)
    t0 = os.now_monotonic_ms()
    f = 0
    while f < 60 {
        n = 0
        while n < 300 {
            core.geom_reset(g)
            core.geom_translate(g, ((n * 37) % 600) * 1.0, ((n * 53) % 440) * 1.0)
            core.draw_image(screen, tile, o)
            n = n + 1
        }
        f = f + 1
    }
    t1 = os.now_monotonic_ms()
    println("60 frames x 300 32px tiles: ${t1 - t0}ms (${(t1 - t0) / 60}ms/frame)")

    // rotated full-screen-ish blit
    big = core.image_new(320, 240)
    core.image_fill(big, 200, 100, 50, 255)
    t2 = os.now_monotonic_ms()
    f = 0
    while f < 60 {
        core.geom_reset(g)
        core.geom_rotate(g, 0.3)
        core.geom_translate(g, 200.0, 100.0)
        core.draw_image(screen, big, o)
        f = f + 1
    }
    t3 = os.now_monotonic_ms()
    println("60 rotated 320x240 blits: ${t3 - t2}ms (${(t3 - t2) / 60}ms/frame)")
}
