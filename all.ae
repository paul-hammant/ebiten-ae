// all.ae — build every ported example as a FAN-OUT of cached per-app aeb
// nodes (the aether-ui .all.ae pattern; aeb Shape A, b-free).
//
//   aeb all.ae                build all ported examples
//   aeb examples/snake        build one
//
// EXTRACTOR-COMPAT BRIDGE (copied from aether-ui's .all.ae) — remove when
// aeb's tools/extract-deps learns the Shape-A spelling; its static pass
// still greps for the OLD needle:
//   scan(b, "examples/**/.build.ae")

import bldr

main() {
    bldr.build() {
        scan("examples/**/.build.ae")
        return 0
    }
}
