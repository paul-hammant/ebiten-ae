// all.ae — build every Aether-port binary as a fan-out of cached per-app
// aeb nodes (the aether-ui .all.ae pattern; dot-prefixed roots break aeb's
// orchestrator symbol, hence the name).
//
//   aeb all.ae             build all ported examples
//   aeb examples/snake     build one

import build

main() {
    b = build.start()
    build.scan(b, "examples/**/.build.ae")
    return 0
}
