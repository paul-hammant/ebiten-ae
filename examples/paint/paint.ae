// paint.ae — port of examples/paint/main.go: drag to paint with a soft 4x4
// brush whose hue rotates over time (the ColorM path). Touch input dropped.
//
//   DISPLAY=:0 ./target/build/examples/paint/bin/paint

import ebiten
import ebiten.core
import std.mem

extern malloc(size: int) -> ptr
extern lrint(x: float) -> long

const SCREEN_W: int = 640
const SCREEN_H: int = 480
const PI: float = 3.14159265358979

// The Go original's 4x4 alpha brush (white, soft edges).
make_brush() -> ptr {
    img = core.image_new(4, 4)
    a0 = 64
    a1 = 192
    a2 = 255
    core.image_set(img, 0, 0, 255, 255, 255, a0)
    core.image_set(img, 1, 0, 255, 255, 255, a1)
    core.image_set(img, 2, 0, 255, 255, 255, a1)
    core.image_set(img, 3, 0, 255, 255, 255, a0)
    core.image_set(img, 0, 1, 255, 255, 255, a1)
    core.image_set(img, 1, 1, 255, 255, 255, a2)
    core.image_set(img, 2, 1, 255, 255, 255, a2)
    core.image_set(img, 3, 1, 255, 255, 255, a1)
    core.image_set(img, 0, 2, 255, 255, 255, a1)
    core.image_set(img, 1, 2, 255, 255, 255, a2)
    core.image_set(img, 2, 2, 255, 255, 255, a2)
    core.image_set(img, 3, 2, 255, 255, 255, a1)
    core.image_set(img, 0, 3, 255, 255, 255, a0)
    core.image_set(img, 1, 3, 255, 255, 255, a1)
    core.image_set(img, 2, 3, 255, 255, 255, a1)
    core.image_set(img, 3, 3, 255, 255, 255, a0)
    return img
}

struct App {
    canvas: ptr
    brush: ptr
    count: int
}

paint(a: *App, x: float, y: float) {
    o = core.opts_new()
    core.geom_translate(core.opts_geom(o), x, y)
    cm = core.colorm_new()
    core.colorm_scale(cm, 1.0, 0.5, 0.125, 1.0)
    theta = 2.0 * PI * ((a.count % 60) * 1.0) / 60.0
    core.colorm_rotate_hue(cm, theta)
    core.opts_set_colorm(o, cm)
    core.draw_image(a.canvas, a.brush, o)
    core.colorm_free(cm)
    core.opts_free(o)
}

main() {
    a = malloc(32) as *App
    a.canvas = core.image_new(SCREEN_W, SCREEN_H)
    core.image_fill(a.canvas, 255, 255, 255, 255)
    a.brush = make_brush()
    a.count = 0

    e = ebiten.game_new(SCREEN_W, SCREEN_H)
    ebiten.on_update(e) callback {
        if ebiten.is_mouse_button_pressed(e, ebiten.MOUSE_BUTTON_LEFT) == 1 {
            paint(a, ebiten.cursor_x(e), ebiten.cursor_y(e))
        }
        a.count = a.count + 1
    }
    ebiten.on_draw(e) callback |screen: ptr| {
        core.draw_image(screen, a.canvas, null)
        cx = lrint(ebiten.cursor_x(e))
        cy = lrint(ebiten.cursor_y(e))
        ebiten.debug_print(e, screen, "(${cx}, ${cy})")
    }
    ebiten.run(e, "Paint (Ebitengine Demo)", SCREEN_W + 20, SCREEN_H + 40)
}
