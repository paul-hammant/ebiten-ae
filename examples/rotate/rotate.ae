// rotate.ae — port of examples/rotate/main.go: an image spinning about its
// center (1 degree per tick), drawn with GeoM translate→rotate→translate.
// The Go original decodes gophers.jpg; no JPEG decoder here (yet), so the
// ebiten.png logo asset is used, scaled 4x.
//
// Run from the repo root (asset path is root-relative):
//   DISPLAY=:0 ./target/build/examples/rotate/bin/rotate

import aebiten
import aebiten.core
import aebiten.png
import std.math

extern println(s: string)
extern exit(code: int)

const SCREEN_W: int = 640
const SCREEN_H: int = 480
const PI: float = 3.14159265358979

main() {
    img = png.png_load("examples/resources/images/ebiten.png")
    if img == null {
        println("rotate: cannot load examples/resources/images/ebiten.png (run from the repo root)")
        exit(1)
    }
    sw = core.image_w(img)
    sh = core.image_h(img)
    aebiten.game("Rotate (Ebitengine Demo)", SCREEN_W, SCREEN_H) {
        draw() callback |e: ptr, screen: ptr| {
            core.image_fill(screen, 32, 32, 48, 255)
            deg = aebiten.tick_count(e) % 360
            // scale 4x about the image center, spin, park at screen center
            core.draw(screen, img) {
                scale(4.0, 4.0)
                translate(0.0 - sw * 2.0, 0.0 - sh * 2.0)
                rotate(deg * 2.0 * PI / 360.0)
                translate(SCREEN_W / 2.0, SCREEN_H / 2.0)
                linear()
            }
            aebiten.debug_print(e, screen, "FPS: ${aebiten.actual_fps(e)}")
        }
    }
}
